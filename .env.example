# ==========================================
# CORE CREDENTIALS (Required)
# ==========================================

# Discord Bot Token (shared with main bot or separate music bot token)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application/Client ID
DISCORD_CLIENT_ID=123456789012345678

# ==========================================
# LAVALINK NODES (Required for audio streaming)
# ==========================================

# PRO node (high quality - 320kbps)
LAVALINK_PRO_HOST=localhost
LAVALINK_PRO_PORT=2333
LAVALINK_PRO_PASSWORD=youshallnotpass
LAVALINK_PRO_SECURE=false

# FREE node (standard quality - 128kbps)
# If you only have one physical node, point both PRO and FREE to the same host/port
LAVALINK_FREE_HOST=localhost
LAVALINK_FREE_PORT=2333
LAVALINK_FREE_PASSWORD=youshallnotpass
LAVALINK_FREE_SECURE=false

# ==========================================
# MUSIC TIER LIMITS (Optional - defaults shown)
# ==========================================

# Free tier limits
MUSIC_FREE_MAX_QUEUE=10
MUSIC_FREE_MAX_VOLUME=80
MUSIC_FREE_MAX_DURATION_SECONDS=300

# Pro tier limits
MUSIC_PRO_MAX_QUEUE=200
MUSIC_PRO_MAX_VOLUME=100
MUSIC_PRO_MAX_DURATION_SECONDS=21600

# ==========================================
# PREMIUM RESOLVER (Optional)
# ==========================================

# Supabase credentials for premium tier lookup (same as main bot)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# ==========================================
# DEPLOYMENT (Optional)
# ==========================================

# Node environment
NODE_ENV=development

# Port for health/status server (if applicable)
PORT=8081
