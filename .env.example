# ==========================================
# CORE CREDENTIALS (Required)
# ==========================================

# Discord Bot Token (shared with main bot or separate music bot token)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application/Client ID
DISCORD_CLIENT_ID=123456789012345678

# ==========================================
# LAVALINK NODES (Required for audio streaming)
# ==========================================

# PRO node (high quality - 320kbps)
LAVALINK_PRO_HOST=localhost
LAVALINK_PRO_PORT=2333
LAVALINK_PRO_PASSWORD=CHANGE_ME
LAVALINK_PRO_SECURE=false

# Lavalink server config used by lavalink/application-vps.example.yml
LAVALINK_ADDRESS=0.0.0.0
LAVALINK_PORT=2333

# FREE node (standard quality - 128kbps)
# If you only have one physical node, point both PRO and FREE to the same host/port
LAVALINK_FREE_HOST=localhost
LAVALINK_FREE_PORT=2333
LAVALINK_FREE_PASSWORD=CHANGE_ME
LAVALINK_FREE_SECURE=false

# ==========================================
# MUSIC TIER LIMITS (Optional - defaults shown)
# ==========================================

# Free tier limits
MUSIC_FREE_MAX_QUEUE=10
MUSIC_FREE_MAX_VOLUME=80
MUSIC_FREE_MAX_DURATION_SECONDS=300

# Pro tier limits
MUSIC_PRO_MAX_QUEUE=200
MUSIC_PRO_MAX_VOLUME=100
MUSIC_PRO_MAX_DURATION_SECONDS=21600

# ==========================================
# PREMIUM RESOLVER (Optional)
# ==========================================

# Supabase credentials for premium tier lookup (same as main bot)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_ANON_KEY=CHANGE_ME

# ==========================================
# YOUTUBE ANTI-BOT TOKENS (Optional — generados automáticamente)
# ==========================================

# poToken y visitorData se generan automáticamente via YouTubeTokenService.
# Solo inyectar manualmente si el servicio falla y necesitas tokens de respaldo.
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=
YOUTUBE_REFRESH_TOKEN=CHANGE_ME
YOUTUBE_REMOTE_CIPHER_URL=CHANGE_ME

# Playwright Chromium path (fallback para generación de poToken)
PLAYWRIGHT_CHROMIUM_PATH=

# Optional residential proxy settings for Lavalink wrapper/system service.
PROXY_HOST=CHANGE_ME
PROXY_PORT=CHANGE_ME
PROXY_USER=CHANGE_ME
PROXY_PASSWORD=CHANGE_ME

# Optional Spotify source credentials for LavaSrc.
SPOTIFY_CLIENT_ID=CHANGE_ME
SPOTIFY_CLIENT_SECRET=CHANGE_ME

# ==========================================
# LOGGING & RATE LIMITING (Optional)
# ==========================================

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Rate limiting de comandos Discord (ms)
COMMAND_COOLDOWN_MS=1500
GUILD_COMMAND_COOLDOWN_MS=800

# ==========================================
# CIRCUIT BREAKER & TIMEOUTS (Optional)
# ==========================================

# Umbral de errores consecutivos antes de abrir circuit breaker
CIRCUIT_BREAKER_THRESHOLD=5

# Tiempo de reset del circuit breaker en ms
CIRCUIT_BREAKER_RESET_MS=60000

# Timeout de inactividad del player en ms (180s = 3 min)
PLAYER_IDLE_TIMEOUT_MS=180000

# Máximo de reintentos por pista antes de saltar
TRACK_MAX_RETRIES=3

# Timeout de resolución de tier premium en ms
TIER_RESOLVE_TIMEOUT_MS=3000

# ==========================================
# UPGRADE URL (Optional)
# ==========================================
PRO_UPGRADE_URL=https://ton618.app/pricing

# ==========================================
# DEPLOYMENT (Optional)
# ==========================================

# Node environment
NODE_ENV=production

# Port for health/status server (if applicable)
PORT=8081
